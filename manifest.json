{
  "manifest_version": 3,
  "name": "LinkCraft - URL & ID Combiner",
  "version": "1.0.0",
  "description": "Combine base URLs or domains with usernames and IDs from text box or uploaded files. Copy, export and open links effortlessly.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LinkCraft - URL & ID Combiner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs"
  ]
}
